<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>FortnitePorting.Mcp</RootNamespace>
        <AssemblyName>FortnitePorting.Mcp</AssemblyName>
        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Serilog" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="ModelContextProtocol" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FortnitePorting.Exporting\FortnitePorting.Exporting.csproj" />
        <ProjectReference Include="..\FortnitePorting.CUE4Parse\FortnitePorting.CUE4Parse.csproj" />
        <ProjectReference Include="..\Dependencies\CUE4Parse\CUE4Parse\CUE4Parse.csproj" />
        <ProjectReference Include="..\Dependencies\CUE4Parse\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\FortnitePorting\Assets\Dependencies\binkadec.exe" Link="Assets\Dependencies\binkadec.exe" />
        <EmbeddedResource Include="..\FortnitePorting\Assets\Dependencies\radadec.exe" Link="Assets\Dependencies\radadec.exe" />
    </ItemGroup>

    <!--
      The unmanaged ACL decoder. Without it every ACL-compressed UAnimSequence - i.e. every
      Fortnite emote - fails to convert and the export silently comes out with no .ueanim.
      CUE4Parse's own Build-Natives target is a no-op without CMake + MSVC, so a known-good
      binary is committed; see runtimes/README.md for its provenance and how to rebuild it.
      It must sit NEXT TO the exe (default P/Invoke probing path), not under runtimes/.
    -->
    <ItemGroup>
        <Content Include="runtimes\CUE4Parse-Natives.dll" Link="CUE4Parse-Natives.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>
</Project>
