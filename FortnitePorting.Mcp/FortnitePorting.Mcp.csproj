<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>FortnitePorting.Mcp</RootNamespace>
        <AssemblyName>FortnitePorting.Mcp</AssemblyName>
        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Serilog" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="ModelContextProtocol" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FortnitePorting.Exporting\FortnitePorting.Exporting.csproj" />
        <ProjectReference Include="..\FortnitePorting.CUE4Parse\FortnitePorting.CUE4Parse.csproj" />
        <ProjectReference Include="..\Dependencies\CUE4Parse\CUE4Parse\CUE4Parse.csproj" />
        <ProjectReference Include="..\Dependencies\CUE4Parse\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
    </ItemGroup>

    <!--
      Hand-maintained mount verification, merged onto the generated scope table by the dump-index
      CLI mode.
      It ships next to the exe rather than embedded so an operator can record a newly verified mount
      after a live editor probe without rebuilding.
    -->
    <ItemGroup>
        <Content Include="Config\mount-verification.json" Link="Config\mount-verification.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\FortnitePorting\Assets\Dependencies\binkadec.exe" Link="Assets\Dependencies\binkadec.exe" />
        <EmbeddedResource Include="..\FortnitePorting\Assets\Dependencies\radadec.exe" Link="Assets\Dependencies\radadec.exe" />
    </ItemGroup>

    <!--
      Build stamp. UEFN round-2 validation lost an hour to a published exe that predated the manifest
      feature: it emitted no manifests, reported no error, and nothing in its output said which build
      was answering. These two assembly metadata values give every manifest and every get_status call
      a "which binary is this?" line, so a stale publish/mcp is visible from the client side.
      The git call is best-effort - a source drop without git still builds, just without the commit.
    -->
    <Target Name="StampBuild" BeforeTargets="GetAssemblyAttributes">
        <PropertyGroup>
            <BuildTimestampUtc>$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))</BuildTimestampUtc>
        </PropertyGroup>

        <Exec Command="git rev-parse --short=10 HEAD"
              WorkingDirectory="$(MSBuildProjectDirectory)"
              ConsoleToMSBuild="true"
              StandardOutputImportance="low"
              StandardErrorImportance="low"
              IgnoreExitCode="true"
              ContinueOnError="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="BuildGitCommit" />
        </Exec>

        <ItemGroup>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>BuildTimestampUtc</_Parameter1>
                <_Parameter2>$(BuildTimestampUtc)</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(BuildGitCommit)' != ''">
                <_Parameter1>GitCommit</_Parameter1>
                <_Parameter2>$(BuildGitCommit.Trim())</_Parameter2>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

    <!--
      The unmanaged ACL decoder. Without it every ACL-compressed UAnimSequence - i.e. every
      Fortnite emote - fails to convert and the export silently comes out with no .ueanim.
      CUE4Parse's own Build-Natives target is a no-op without CMake + MSVC, so a known-good
      binary is committed; see runtimes/README.md for its provenance and how to rebuild it.
      It must sit NEXT TO the exe (default P/Invoke probing path), not under runtimes/.
    -->
    <ItemGroup>
        <Content Include="runtimes\CUE4Parse-Natives.dll" Link="CUE4Parse-Natives.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>
</Project>
